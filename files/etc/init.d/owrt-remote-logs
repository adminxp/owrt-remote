#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=11

start_service() {
	/bin/sh /usr/lib/owrt-remote/logs.sh migrate || logger -t owrt-remote 'WARN: старый RAM-журнал ещё не перенесён; см. свободное место Flash.'
	procd_open_instance journal
	procd_set_param command /bin/sh /usr/lib/owrt-remote/logs.sh collect
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance archive
	procd_set_param command /bin/sh /usr/lib/owrt-remote/logs.sh sync
	procd_set_param env OWRT_REMOTE_SERVICE_LOG=1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	# Flush a last bounded batch on ordinary stop/shutdown. Sudden power loss can
	# lose only the current RAM write buffer; committed immutable chunks survive.
	/bin/sh /usr/lib/owrt-remote/logs.sh flush force >/dev/null 2>&1 || true
}
