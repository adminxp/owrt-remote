#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=11

start_service() {
	procd_open_instance journal
	procd_set_param command /bin/sh /usr/lib/owrt-remote/logs.sh collect
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance archive
	procd_set_param command /bin/sh /usr/lib/owrt-remote/logs.sh sync
	procd_set_param env OWRT_REMOTE_SERVICE_LOG=1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
